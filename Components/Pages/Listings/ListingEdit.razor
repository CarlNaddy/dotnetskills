@page "/listings/{Id:int}/edit"
@inject IDbContextFactory<AppDbContext> DbFactory
@inject NavigationManager Nav
@inject ISnackbar Snackbar

<PageTitle>Edit listing</PageTitle>

@if (_model is null)
{
    @if (_loaded)
    {
        <MudAlert Severity="Severity.Error">Listing @Id was not found.</MudAlert>
        <MudButton Class="mt-4" Href="/listings" Variant="Variant.Text">Back to listings</MudButton>
    }
    else
    {
        <MudProgressCircular Indeterminate="true" />
    }
}
else
{
    <MudText Typo="Typo.h4" GutterBottom="true">Edit: @_model.Title</MudText>

    <MudPaper Class="pa-4" Elevation="1">
        <ListingEditor Model="_model" SubmitLabel="Save changes" OnSubmit="SaveAsync"
                       OnCancel="@(() => Nav.NavigateTo($"/listings/{Id}"))" />
    </MudPaper>
}

@code {
    [Parameter] public int Id { get; set; }

    private Listing? _model;
    private bool _loaded;

    protected override async Task OnInitializedAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        _model = await db.Listings.FindAsync(Id);
        _loaded = true;
    }

    private async Task SaveAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        db.Listings.Update(_model!);
        await db.SaveChangesAsync();

        Snackbar.Add("Changes saved.", Severity.Success);
        Nav.NavigateTo($"/listings/{Id}");
    }
}
