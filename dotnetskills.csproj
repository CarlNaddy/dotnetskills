<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <!-- Nullable, ImplicitUsings, LangVersion, analyzers: see Directory.Build.props -->
    <UserSecretsId>230b5278-ccf0-4f1b-9ff6-0692cadb3827</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MudBlazor" Version="9.9.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- EF Core 10 + PostgreSQL — see CLAUDE.md "Data access". Npgsql brings
         Microsoft.EntityFrameworkCore(.Relational) transitively. Design is
         build-only (dotnet ef / migrations). -->
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.11">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

</Project>
